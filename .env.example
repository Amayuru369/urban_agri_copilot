# UrbanAgri-Copilot environment variables

# SQLite database URL
DATABASE_URL=sqlite:///./urban_agri_copilot.db

# Open-Meteo base URL (usually left as the default)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Alibaba Cloud Model Studio (DashScope) API key.
# Set this to enable qwen-vl-plus vision-based leaf diagnosis.
# If absent, the app falls back to the on-device pixel analyzer.
DASHSCOPE_API_KEY=

# Optional: override the DashScope OpenAI-compatible endpoint.
# The default international endpoint is shown below.
# DASHSCOPE_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# Qoder Vision API personal access token.
# Set this to prioritize the Qoder Vision API for leaf diagnosis.
# If absent, the pipeline falls back to Gemini, Hugging Face, then the pixel analyzer.
QODER_PERSONAL_ACCESS_TOKEN=

# Optional: override the Qoder Vision API endpoint.
# QODER_VISION_ENDPOINT=https://api.qoder.com/v1/vision/diagnose
